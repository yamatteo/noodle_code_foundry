# Zola site configuration
# Placeholder: the CI build overrides it with --base-url, and `zola serve` uses localhost.
base_url = "https://example.com"
title = {{ project_name | tojson }}
description = {{ description | tojson }}
author = {{ author_name | tojson }}
default_language = "en"

# Theme configuration
theme = "MATbook"

# Build settings
compile_sass = true
build_search_index = true
minify_html = true

# Taxonomies
taxonomies = [
  {name = "tags", feed = true},
  {name = "categories", feed = true}
]

# MATbook theme specific settings
[extra]
# MathJax support for mathematical content
mathjax = true

# MATbook theme settings
[extra.booktheme]
# Enable chapter numbering
book_number_chapters = true
# Show only current section pages in navigation
book_only_current_section_pages = false
# Home link (can be your homepage or guide page)
home = "/"

# Markdown rendering settings
[markdown]
highlighting = { theme = "github-dark" }
render_emoji = true
external_links_target_blank = true
smart_punctuation = true
