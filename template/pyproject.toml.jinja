[project]
name = "{{ project_slug | replace('_', '-') }}"
version = "0.1.0"
description = "{{ description }}"
readme = "README.md"
authors = [
    { name = "{{ author_name }}", email = "{{ author_email }}" }
]
{%- if license != 'None' %}
license = "{{ license }}"
{%- endif %}
requires-python = ">=3.13"
dependencies = [
    "python-dotenv>=1.2.2",
]

[project.scripts]
{{ project_slug | replace('_', '-') }} = "{{ project_slug }}:main"

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"
